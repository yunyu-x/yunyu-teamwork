{
  "name": "yunyu-teamwork",
  "version": "0.4.0",
  "description": "云驭协同（Yunyu Teamwork）— 开源多 Agent 蜂群协同研发、项目世界模型、活文档 Wiki 与 GitLab 双向联动平台（零外部依赖、异构 Agent、Git Worktree 隔离、Qoder Issue 中心、MCP 服务端）",
  "type": "module",
  "license": "MIT",
  "author": "Yunyu Teamwork Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yunyu-x/yunyu-teamwork.git"
  },
  "homepage": "https://github.com/yunyu-x/yunyu-teamwork#readme",
  "bugs": {
    "url": "https://github.com/yunyu-x/yunyu-teamwork/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "yunyu": "./bin/yunyu.mjs",
    "yunyu-mcp": "./bin/yunyu-mcp.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./gitlab": "./src/gitlab/index.mjs",
    "./drivers": "./src/drivers/registry.mjs",
    "./mcp": "./src/mcp/server.mjs"
  },
  "keywords": [
    "multi-agent",
    "agent-swarm",
    "teamwork",
    "world-model",
    "living-wiki",
    "gitlab",
    "git-worktree",
    "mcp",
    "issue-tracker",
    "kanban",
    "digital-twin",
    "knowledge-base",
    "feishu",
    "dingtalk",
    "zero-dependencies",
    "ai-engineering",
    "claude-code",
    "codex",
    "gemini",
    "project-management"
  ],
  "scripts": {
    "start": "node bin/yunyu.mjs serve",
    "demo": "node bin/yunyu.mjs demo",
    "demo:cli": "node examples/cli-agent-collab.mjs",
    "audit": "node bin/yunyu.mjs audit",
    "wiki": "node bin/yunyu.mjs wiki",
    "mcp": "node bin/yunyu-mcp.mjs",
    "check": "node scripts/check-syntax.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test": "node --test tests/unit/*.test.mjs tests/integration/*.test.mjs",
    "qa:ui": "node tests/ui/cdp-ui-qa.mjs",
    "verify": "npm run check && npm test && npm run qa:ui && npm run audit"
  },
  "files": [
    "bin/",
    "src/",
    "web/",
    "examples/",
    "docs/",
    "LICENSE",
    "README.md",
    "README.en.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    ".env.example"
  ]
}
