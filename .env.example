# ==============================================================================
# Yunyu Teamwork（云驭协同）环境变量配置示例
# 复制为 .env 后按需填写；内置本地 Demo 与离线模拟模式无需配置任何 API Key
# ==============================================================================

# 服务监听配置
YUNYU_HOST=127.0.0.1
YUNYU_PORT=4310
YUNYU_DATA_DIR=.yunyu
YUNYU_DEFAULT_LANG=zh-CN

# 目标 Git 仓库路径（可为任意本地 GitLab 克隆仓库）
YUNYU_REPO_PATH=.

# GitLab 实例连接配置（支持 gitlab.com 与自托管企业版 GitLab CE/EE）
GITLAB_BASE_URL=https://gitlab.com
GITLAB_TOKEN=glpat-replace-with-your-project-or-personal-token
GITLAB_PROJECT_ID=group/your-project
GITLAB_WEBHOOK_SECRET=replace-with-shared-webhook-secret
GITLAB_DEFAULT_BRANCH=main

# OpenAI 兼容模型默认配置（支持 OpenAI / DeepSeek / 通义千问 / OpenRouter / Ollama）
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o

# 可选：自定义外部 CLI Agent 命令路径
CLAUDE_CLI_BIN=claude
CODEX_CLI_BIN=codex
GEMINI_CLI_BIN=gemini

# 安全与插件权限门禁（生产环境建议保持默认 false，按需开启）
YUNYU_API_TOKEN=
YUNYU_CORS_ORIGIN=
YUNYU_ALLOW_CUSTOM_CLI=false
YUNYU_ALLOW_EXEC_HOOKS=false
YUNYU_ALLOW_MCP_STDIO=false
YUNYU_ALLOW_PRIVATE_MCP_HTTP=false
